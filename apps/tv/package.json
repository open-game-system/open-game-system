{
  "name": "@open-game-system/tv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OGS TV launcher: the page the Chromecast stream shows all evening; frames each game's TV page",
  "scripts": {
    "dev": "vite --host --port 5180 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5180 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text-summary",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@open-game-system/ogs-protocol": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.0"
  }
}
