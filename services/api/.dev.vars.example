# Copy to .dev.vars for `pnpm dev:local`. Never commit .dev.vars.
OGS_JWT_SECRET=local-dev-secret
# Sign-in against vercel-labs/emulate (`pnpm emulate`), not the real providers:
APPLE_ISSUER=http://localhost:4104
APPLE_CLIENT_IDS=org.opengame.app
GOOGLE_ISSUER=http://localhost:4102
GOOGLE_CLIENT_IDS=ogs-test.apps.googleusercontent.com
# Email codes need nothing here: `wrangler dev` simulates SEND_EMAIL (nothing is delivered) and lists
# what it sent at http://localhost:<port>/cdn-cgi/local/explorer/api/local/email/sending.
# Game tokens (slice 3): `pnpm game-key` writes a fresh OGS_GAME_SIGNING_KEY (private ES256 JWK) here.
OGS_GAME_SIGNING_KEY='{"kty":"EC","crv":"P-256","x":"…","y":"…","d":"…","kid":"ogs-local"}'
AVATAR_BASE_URL=http://localhost:5180
# Optional: open catalogue games from local dev servers (e2e), JSON { appId: startUrl }.
# CATALOGUE_START_URLS={"rocket-crew":"http://localhost:8821/"}
