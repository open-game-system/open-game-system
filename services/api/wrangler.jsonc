{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opengame-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "account_id": "ccf4d9a0a3b76ffae0b6ee048de66f07",

  // Sign-in providers (OGS profiles). Secrets (OGS_JWT_SECRET and
  // OGS_GAME_SIGNING_KEY: `node scripts/game-key.mjs --print | wrangler secret put OGS_GAME_SIGNING_KEY`) are set with
  // `wrangler secret put`; local dev overrides these in .dev.vars (see .dev.vars.example).
  "vars": {
    "APPLE_ISSUER": "https://appleid.apple.com",
    "APPLE_CLIENT_IDS": "org.opengame.app",
    "GOOGLE_ISSUER": "https://accounts.google.com",
    "GOOGLE_CLIENT_IDS": "",
    // Email sign-in codes go out from this address through SEND_EMAIL (below).
    "EMAIL_FROM": "sign-in@opengame.org",
    // Game tokens: avatars are the launcher's painted stickers (<base>/art/story-nook/char-<sticker>.webp).
    "AVATAR_BASE_URL": "https://ogs-tv.pages.dev"
  },

  // Cloudflare Email Service (Email Sending): env.SEND_EMAIL.send({ from, to, subject, text, html }).
  // Needs opengame.org onboarded under Compute > Email Service > Email Sending (SPF/DKIM/DMARC) on
  // this account (Workers Paid). Locally (`wrangler dev`, vitest) nothing is delivered: wrangler dev
  // captures each message and lists it at /cdn-cgi/local/explorer/api/local/email/sending.
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "allowed_sender_addresses": ["sign-in@opengame.org"]
    }
  ],

  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opengame-api-db",
      "database_id": "cec599e8-e064-4034-b035-3d97ed3b222c"
    }
  ],

  "containers": [
    {
      "name": "codeflare-containers",
      "image": "./container/Dockerfile",
      "class_name": "StreamContainer",
      "max_instances": 2,
      "instance_type": "standard"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "STREAM_CONTAINER",
        "class_name": "StreamContainer"
      },
      {
        "name": "COUCH_SESSION",
        "class_name": "CouchSession"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StreamContainer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CouchSession"]
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
