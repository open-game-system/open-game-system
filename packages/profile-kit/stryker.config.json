{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.schema.json",
  "testRunner": "vitest",
  "appendPlugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/test-keys.ts"
  ],
  "reporters": [
    "json",
    "clear-text"
  ],
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": 60
  },
  "vitest": {
    "related": false
  }
}
