{
  "name": "@open-game-system/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text-summary",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 execute opengame-api-db --file=schema.sql",
    "test:e2e": "playwright test",
    "db:local": "wrangler d1 execute opengame-api-db --local --file=schema.sql",
    "dev:local": "wrangler dev --enable-containers=false",
    "emulate": "node scripts/emulate.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.1.1",
    "@open-game-system/ogs-protocol": "workspace:*",
    "hono": "^4.12.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.13.2",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.1.0",
    "emulate": "0.12.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.75.0"
  }
}
